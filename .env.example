# Copy to .env and fill in. Names only here; never commit real values.
# On Vercel, add the same names under Project Settings > Environment Variables.
# Only NEXT_PUBLIC_ variables reach the browser.

# --- Agora (required) ---------------------------------------------------
# From the Agora Console project. The App ID is not secret.
AGORA_APP_ID=
NEXT_PUBLIC_AGORA_APP_ID=
# Secret, server only. Used to mint RTC/RTM tokens.
AGORA_APP_CERTIFICATE=
# Optional. Pin where the agent runs: ASIA, NORTH_AMERICA, EUROPE, INDIA, JAPAN or GLOBAL.
# Unset lets Agora choose, based on where your language model is.
# AGORA_REGION=ASIA

# --- Avatar -------------------------------------------------------------
# orb (default: no key, your own picture or an animated circle, no lip-sync).
# anam or heygen turn on an experimental lip-synced avatar option; both are Beta at Agora and
# did not start reliably in our tests (see docs/feasibility.md).
AVATAR_PROVIDER=orb
ANAM_API_KEY=
# Avatar ID from the Anam Lab (or created through the Anam API from your own photo)
ANAM_AVATAR_ID=
# Optional. Force an Anam avatar model, for example cara-4. Leave unset to let Anam choose.
# ANAM_AVATAR_MODEL=
# Optional providers
# HeyGen LiveAvatar: the key comes from the LiveAvatar console, not the main HeyGen dashboard.
HEYGEN_API_KEY=
# Optional: without it LiveAvatar uses its default avatar.
HEYGEN_AVATAR_ID=
# Optional: low (360p), medium (480p, default) or high (720p).
# HEYGEN_QUALITY=
# AKOOL_API_KEY=
# AKOOL_AVATAR_ID=

# --- Language model (writes the narration; free-tier Gemini key works) --
# gemini (default), groq (text only, needs LLM_MODEL), or mock (no model, for trying the app)
LLM_PROVIDER=gemini
# Optional. Defaults to gemini-4-hydrogen for Gemini. Required for groq.
# LLM_MODEL=
GOOGLE_API_KEY=
# GROQ_API_KEY=

# --- Text-to-speech and speech-to-text (used by the Agora agent) --------
# managed (default, Agora-managed voice, no key) or elevenlabs (needs TTS_API_KEY).
# The avatar sample rate is 24000 Hz for Anam and HeyGen, 16000 Hz for Akool.
TTS_VENDOR=managed
# TTS_API_KEY=
# TTS_VOICE_ID=
# ASR_VENDOR=
# ASR_API_KEY=

# --- Recording ----------------------------------------------------------
# Recording happens in the browser (free, no bucket). Agora Cloud Recording is not built in this recipe.
RECORDING_MODE=local

# --- App ----------------------------------------------------------------
# http://localhost:3000 locally, the deployment URL on Vercel
APP_BASE_URL=http://localhost:3000
# Only if you store files in Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# --- Access control -----------------------------------------------------
# REQUIRED on a public deployment. Every route that spends money (agents, language model) asks for it.
# In production with this unset, the app refuses all requests. Locally it can stay empty.
APP_ACCESS_CODE=
